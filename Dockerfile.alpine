# syntax=docker/dockerfile:1
FROM alpine:latest AS builder
#experimental
RUN apk update && apk add --no-cache \
    autoconf automake build-base bzip2 cmake coreutils curl file \
    git jansson-dev jansson-static lame-dev libass-dev libjpeg-turbo-dev libjpeg-turbo-static libtheora-dev \
    libtool libvorbis-dev libvpx-dev libxml2-dev m4 make meson nasm \
    ninja numactl-dev opus-dev patch pkgconf python3 speex-dev tar \
    x264-dev x265-dev yasm zlib-dev zip

RUN apk update && apk add --no-cache \
    autoconf automake build-base bzip2 cmake coreutils curl file \
    git jansson-dev jansson-static lame-dev lame-libs libass-dev \
    libjpeg-turbo-dev libjpeg-turbo-static libtheora-dev libtheora-static \
    libtool libvorbis-dev libvorbis-static libvpx-dev libvpx-utils libxml2-dev libxml2-static \
    m4 make meson nasm ninja numactl-dev opus-dev opus-tools patch pkgconf \
    python3 speex-dev speex-tools tar x264-dev x264-libs x265-dev x265-libs yasm zlib-dev zlib-static zip

WORKDIR /tmp/mimalloc
RUN git clone --depth 1 https://github.com/microsoft/mimalloc.git . && \
    mkdir build && cd build && \
    cmake -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DMI_BUILD_SHARED=OFF \
        -DMI_BUILD_STATIC=ON \
        -DMI_BUILD_OBJECTS=OFF \
        -DMI_BUILD_TESTS=OFF \
        -DMI_OVERRIDE=ON \
        .. && \
    ninja

WORKDIR /tmp/libs
RUN apk add --no-cache wget && \
    export PREFIX=/usr/local && \
    export PKG_CONFIG_PATH="$PREFIX/lib64/pkgconfig:$PREFIX/lib/pkgconfig:$PKG_CONFIG_PATH" && \
    export CPPFLAGS="-I$PREFIX/include -I/usr/include" && \
    export LDFLAGS="-L$PREFIX/lib64 -L$PREFIX/lib -static -static-libgcc" && \
    \
    # zlib
    git clone https://github.com/madler/zlib.git && \
    cd zlib && \
    ./configure --prefix=$PREFIX --static && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # x264
    git clone https://github.com/mirror/x264.git && \
    cd x264 && \
    ./configure --enable-static --disable-shared --enable-pic --prefix="$PREFIX" && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # libjpeg-turbo
    git clone --depth 1 https://github.com/libjpeg-turbo/libjpeg-turbo.git && \
    cd libjpeg-turbo && \
    cmake -G"Unix Makefiles" \
      -DCMAKE_INSTALL_PREFIX="$PREFIX" \
      -DENABLE_SHARED=OFF -DENABLE_STATIC=ON \
      -DWITH_JPEG8=ON . && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # lame
    wget -q https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz && \
    tar xf lame-3.100.tar.gz && \
    cd lame-3.100 && \
    ./configure --enable-static --disable-shared --prefix="$PREFIX" && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # ogg
    git clone --depth 1 https://github.com/xiph/ogg.git && \
    cd ogg && \
    ./autogen.sh && \
    ./configure --prefix="$PREFIX" --enable-static --disable-shared && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # vorbis
    git clone --depth 1 https://github.com/xiph/vorbis.git && \
    cd vorbis && \
    ./autogen.sh && \
    ./configure --prefix="$PREFIX" --enable-static --disable-shared && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # opus
    git clone --depth 1 https://github.com/xiph/opus.git && \
    cd opus && \
    ./autogen.sh || true && \
    ./configure --prefix="$PREFIX" --enable-static --disable-shared --with-pic && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # libvpx
    git clone --depth 1 https://chromium.googlesource.com/webm/libvpx && \
    cd libvpx && \
    ./configure --prefix="$PREFIX" \
                --enable-static --disable-shared \
                --disable-examples --disable-unit-tests \
                --disable-docs --disable-runtime-cpu-detect && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # speex
    git clone --depth 1 https://github.com/xiph/speex.git && \
    cd speex && \
    ./autogen.sh || true && \
    ./configure --prefix="$PREFIX" --enable-static --disable-shared --with-pic && \
    make -j$(nproc) && make install && \
    cd .. && \
    \
    # libvorbis dependencies are handled above
    ldconfig || true

WORKDIR /tmp/handbrake
RUN git clone --depth 1 https://github.com/HandBrake/HandBrake.git . && \
    echo "GCC.args.extra += -I/tmp/mimalloc/include -D_LARGEFILE64_SOURCE -D_GNU_SOURCE" > custom.defs && \
    echo "TEST.GCC.args.extra += -static -L/tmp/mimalloc/build -lmimalloc -lpthread -lrt" >> custom.defs && \
    ./configure --disable-gtk && \
    make -C build -j$(nproc) && \
    strip build/HandBrakeCLI

WORKDIR /export
RUN cp /tmp/handbrake/build/HandBrakeCLI . && \
    zip -9 handbrake-musl-mimalloc.zip HandBrakeCLI

FROM scratch AS exporter
COPY --from=builder /export/handbrake-musl-mimalloc.zip /
